{
  "name": "token-tome",
  "version": "1.0.0",
  "private": true,
  "description": "A Webster-style dictionary of every token an AI model reads.",
  "type": "module",
  "scripts": {
    "start": "npx serve .",
    "build:data": "node scripts/build-vocab.mjs && python3 scripts/label-invisible.py",
